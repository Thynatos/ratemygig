# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Events Provider Configuration
# Options:
# - mock: DB mock rows first, then mock seed fallback
# - ticketmaster: DB Ticketmaster rows first, then live TM when VITE_TICKETMASTER_API_KEY is set, never mock
# - all: all DB rows first, then live TM, then mock seed fallback
VITE_EVENTS_PROVIDER=mock

# Optional: Ticketmaster API Key (only needed if VITE_EVENTS_PROVIDER=ticketmaster)
# VITE_TICKETMASTER_API_KEY=your-ticketmaster-api-key

# ============================================
# Daily Ingestion Job Configuration
# ============================================

# Ticketmaster API Key (required for daily job)
# Get your API key at: https://developer.ticketmaster.com/
TICKETMASTER_API_KEY=your-ticketmaster-api-key

# Supabase Service Role Key (required for jobs, bypasses RLS)
# Found in Supabase Dashboard -> Settings -> API -> service_role key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Ingestion Settings
# INGEST_COUNTRIES: Comma-separated country codes (US, UK, CA, etc.)
INGEST_COUNTRIES=US
# INGEST_CLASSIFICATION: Event classification (music, sports, arts, etc.)
INGEST_CLASSIFICATION=music
# INGEST_DAYS_AHEAD: How many days ahead to fetch events
INGEST_DAYS_AHEAD=180
